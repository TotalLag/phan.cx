---
import Layout from '../layouts/Layout.astro';
import type { ResumeData } from '../types/resume';
import { obfuscateEmail } from '../utils/email';
import strategicJson from '../content/resume/strategic.json';
import technicalJson from '../content/resume/technical.json';

const type = Astro.url.searchParams.get('type') || 'strategic';
const resume = (type === 'technical' ? technicalJson : strategicJson) as ResumeData;
const obfuscatedEmail = obfuscateEmail(resume.info.email);
---

<Layout title={`${resume.info.name} - Resume`}>
  <meta name="robots" content="noindex, nofollow, noarchive" slot="head" />

<div class="grid items-center grid-cols-3 justify-self-stretch print:hidden">
  <div class="p-4 justify-self-start whitespace-nowrap">🖨️-friendly 😉</div>
  <ul class="flex my-4 text-sm font-medium flex-nowrap sm:justify-self-center justify-self-between">
    <a href="/resume">
      <li class={type !== 'technical' ? 'selected' : ''}>
        Strategic
      </li>
    </a>
    <a href="/resume?type=technical">
      <li class={type === 'technical' ? 'selected' : ''}>
        Technical
      </li>
    </a>
  </ul>
</div>

<style>
  .selected {
    @apply font-bold text-gray-800 dark:text-gray-100;
    @apply border-b-2 border-gray-700 dark:border-gray-300;
  }

  article {
    @apply font-sans text-sm leading-normal tracking-wide;
    @apply text-gray-900 dark:text-gray-100;
    @apply bg-white dark:bg-gray-800;
    @apply p-6 border border-gray-200 dark:border-gray-700;
    @apply rounded shadow-sm;
  }

  @media print {
    article {
      @apply text-xs leading-snug;
      @apply border-0 shadow-none;
    }
  }

  h1 {
    @apply text-2xl font-bold uppercase mb-2;
  }

  h2 {
    @apply text-xl font-bold uppercase mb-2;
  }

  h3 {
    @apply text-base font-bold mb-1;
  }

  ul {
    @apply list-disc pl-6 mb-4;
  }
</style>

<div class="flex flex-col p-6 mx-auto align-middle border-8 print:-mt-2 print:border-0 print:max-w-[49rem] md:w-4/5">
  <article class="border-0 border-b border-black">
    <div class="flex flex-col pb-2 border-0 border-b-2 border-black">
      <div class="flex mx-auto">
        <h1>{resume.info.name}</h1>
      </div>
    </div>

    <div class="flex p-1 border-0 border-b-2 border-black">
      <div class="flex mx-auto">
        <span> {resume.info.address} | {resume.info.phone} | {obfuscatedEmail} </span>
      </div>
    </div>

    <div class="flex p-4">
      <div class="mx-auto">
        <h2 class="summary">{resume.summary.map(item => item.item).join(' ◆ ')}</h2>
      </div>
    </div>
  </article>

  <article>
    <div class="flex pb-1 mb-3 border-0 border-b border-gray-200">
      <div class="flex flex-col">
        <h2>Summary of Qualifications</h2>
      </div>
    </div>

    <div class="flex pb-2 border-0 border-b border-black">
      <ul>
        {resume.qualifications.map((line) => <li>{line.item}</li>)}
      </ul>
    </div>
  </article>

  <article class="mb-1 border-0 border-b border-black">
    <div class="flex pb-1 mb-3 border-0 border-b border-gray-200">
      <div class="flex flex-col">
        <h2>Work Experience</h2>
      </div>
    </div>

    {resume.experience.map((job) => (
      <>
        <div class="flex justify-between">
          <h3>{job.title} | {job.company} <span class="font-light">| {job.location}</span></h3>
          <span> {job.dateFrom} &mdash; {job.dateTo} </span>
        </div>
        <div class="flex mb-3">
          <ul>
            {job.work.map((line) => <li>{line.item}</li>)}
          </ul>
        </div>
      </>
    ))}
  </article>

  {resume.education && (
    <article>
      <div class="flex pb-1 mb-3 border-0 border-b border-gray-200">
        <div class="flex flex-col">
          <h2>Education</h2>
        </div>
      </div>

      {resume.education.map((school) => (
        <div class="flex justify-between mb-4">
          <h3>{school.degree} | {school.name} <span class="font-light">| {school.location}</span></h3>
          <span> {school.dateFrom} &mdash; {school.dateTo} </span>
        </div>
      ))}
    </article>
  )}
</div>
