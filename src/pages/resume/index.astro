---
import ResumeLayout from '../../layouts/ResumeLayout.astro';
import type { ResumeData, StrategicResumeData } from '../../types/resume';
import strategicJson from '../../content/resume/strategic.json';
import { createLogger } from '../../utils/logger';

const resumeLogger = createLogger('StrategicResumePage');

const resume: ResumeData = {
  ...strategicJson,
  type: 'strategic' as const,
  metadata: {
    lastUpdated: new Date().toISOString()
  }
} satisfies StrategicResumeData;

resumeLogger.debug(`Loaded strategic resume for ${resume.info.name}`);

const structuredData = {
  "@type": "WebPage",
  "name": `Strategic Resume - ${resume.info.name}`,
  "description": `Professional strategic resume for ${resume.info.name}, highlighting key qualifications and professional achievements`,
  "mainEntity": {
    "@type": "Person",
    "name": resume.info.name,
    "jobTitle": resume.experience[0]?.title || "Professional",
    "skills": resume.qualifications.map(q => q.item)
  }
};

resumeLogger.info(`Generated structured data for ${resume.info.name}'s strategic resume`);
---

<ResumeLayout 
  resume={resume} 
  type="strategic" 
  structuredData={structuredData}
/>
