---
import Layout from '../../layouts/Layout.astro';
import ResumeLayout from '../../layouts/ResumeLayout.astro';
import type { ResumeData } from '../../types/resume';
import strategicJson from '../../content/resume/strategic.json';

const resume = strategicJson as ResumeData;
---

<Layout title={`${resume.info.name} - Resume`}>
  <meta name="robots" content="noindex, nofollow, noarchive" slot="head" />
  <ResumeLayout resume={resume} type="strategic" />
</Layout>
