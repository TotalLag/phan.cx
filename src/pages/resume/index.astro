---
import { getCollection } from 'astro:content';
import ResumeLayout from '../../layouts/ResumeLayout.astro';

const resumes = await getCollection('resume');
const strategicResume = resumes.find(r => r.id === 'strategic.json');

if (!strategicResume) {
  throw new Error('Strategic resume not found');
}

const resume = strategicResume.data;
---

<ResumeLayout data={resume} type="strategic" />
