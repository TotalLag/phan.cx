---
import ResumeLayout from '../../layouts/ResumeLayout.astro';
import type { ResumeData, TechnicalResumeData } from '../../types/resume';
import technicalJson from '../../content/resume/technical.json';

const resume: ResumeData = {
  ...technicalJson,
  type: 'technical' as const,
  metadata: {
    lastUpdated: new Date().toISOString()
  }
} satisfies TechnicalResumeData;

const structuredData = {
  "@type": "WebPage",
  "name": `Technical Resume - ${resume.info.name}`,
  "description": `Professional technical resume for ${resume.info.name}, highlighting technical skills and professional expertise`,
  "mainEntity": {
    "@type": "Person",
    "name": resume.info.name,
    "jobTitle": resume.experience[0]?.title || "Technical Professional",
    "skills": resume.qualifications.map(q => q.item)
  }
};
---

<ResumeLayout 
  resume={resume} 
  type="technical" 
  structuredData={structuredData}
/>
