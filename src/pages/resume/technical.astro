---
import { getCollection } from 'astro:content';
import ResumeLayout from '../../layouts/ResumeLayout.astro';

const resumes = await getCollection('resume');
const technicalResume = resumes.find(r => r.id === 'technical.json');

if (!technicalResume) {
  throw new Error('Technical resume not found');
}

const resume = technicalResume.data;
---

<ResumeLayout data={resume} type="technical" />
