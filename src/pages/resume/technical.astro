---
import { getCollection } from 'astro:content';
import ResumeLayout from '../../layouts/ResumeLayout.astro';
import type { ResumeCollection } from '../../content/config';

const resumes = await getCollection('resume');
const technicalResume = resumes.find(r => r.data.type === 'technical');

if (!technicalResume) {
  throw new Error('Technical resume not found');
}

const resume = technicalResume.data;
---

{
  resume ? (
    <ResumeLayout data={resume} type="technical" />
  ) : (
    <div class="p-6 text-center">
      <h1 class="text-xl font-bold">Error</h1>
      <p>Technical resume data could not be loaded.</p>
    </div>
  )
}
