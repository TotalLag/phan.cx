---
import strategicJson from '../../../src/content/resume/strategic.json';
import technicalJson from '../../../src/content/resume/technical.json';

// Legacy JSON structure type
interface LegacyResumeData {
  resume: {
    info: {
      name: string;
      address: string;
      phone: string;
      email: string;
    };
    summary: { item: string }[];
    qualifications: { item: string }[];
    experience: {
      title: string;
      company: string;
      location: string;
      dateFrom: string;
      dateTo: string;
      work: { item: string }[];
    }[];
    education?: {
      degree: string;
      name: string;
      location: string;
      dateFrom: string;
      dateTo: string;
    }[];
  };
}

// Target schema type
interface ResumeData {
  type: 'strategic' | 'technical';
  info: {
    name: string;
    address: string;
    phone: string;
    email: string;
  };
  summary: { item: string }[];
  qualifications: { item: string }[];
  experience: {
    title: string;
    company: string;
    location: string;
    dateFrom: string;
    dateTo: string;
    work: { item: string }[];
  }[];
  education?: {
    degree: string;
    name: string;
    location: string;
    dateFrom: string;
    dateTo: string;
  }[];
}

const strategicLegacy = strategicJson as LegacyResumeData;
const technicalLegacy = technicalJson as LegacyResumeData;

// Transform to target schema
const strategicResume: ResumeData = {
  ...strategicLegacy.resume,
  type: 'strategic'
};

const technicalResume: ResumeData = {
  ...technicalLegacy.resume,
  type: 'technical'
};

const { type } = Astro.params;
const resume: ResumeData = type === 'technical' ? technicalResume : strategicResume;
---

<style>
  article {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: var(--resume-text-base);
    line-height: var(--resume-leading-normal);
    letter-spacing: var(--resume-tracking-base);
    color: var(--paper-text);
    background-color: var(--paper-bg);
    padding: var(--gutter);
    border: 1px solid var(--resume-border-light);
    border-radius: 4px;
    box-shadow: 0 2px 4px var(--paper-shadow);
  }

  @media print {
    article {
      font-size: var(--resume-text-print);
      line-height: var(--resume-leading-print);
    }
  }

  h1 {
    font-size: 2rem;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: bold;
    margin-bottom: 0.25rem;
  }

  ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .selected {
    font-weight: bold;
    color: var(--text-color);
    border-color: var(--border-color);
  }
</style>

<svelte:head>
  <meta name="robots" content="noindex, nofollow, noarchive" />
</svelte:head>

<div class="grid items-center grid-cols-3 justify-self-stretch print:hidden">
  <div class="p-4 justify-self-start whitespace-nowrap">🖨️-friendly 😉</div>
  <ul class="flex my-4 text-sm font-medium flex-nowrap sm:justify-self-center justify-self-between">
    <a href="/resume">
      <li class={type !== 'technical' ? 'selected' : ''}>
        Strategic
      </li>
    </a>
    <a href="/resume/technical">
      <li class={type === 'technical' ? 'selected' : ''}>
        Tactical
      </li>
    </a>
  </ul>
</div>

<div class="flex flex-col p-6 mx-auto align-middle border-8 print:-mt-2 print:border-0 print:max-w-[49rem] md:w-4/5">
  <article class="border-0 border-b border-black">
    <div class="flex flex-col pb-2 border-0 border-b-2 border-black">
      <div class="flex mx-auto">
        <h1>{resume.info.name}</h1>
      </div>
    </div>

    <div class="flex p-1 border-0 border-b-2 border-black">
      <div class="flex mx-auto">
        <span> {resume.info.address} | {resume.info.phone} | {@html resume.info.email} </span>
      </div>
    </div>

    <div class="flex p-4">
      <div class="mx-auto">
        <h2 class="summary">{resume.summary.map((i) => i.item).join(' ◆ ')}</h2>
      </div>
    </div>
  </article>

  <article>
    <div class="flex pb-1 mb-3 border-0 border-b border-gray-200">
      <div class="flex flex-col">
        <h2>Summary of Qualifications</h2>
      </div>
    </div>

    <div class="flex pb-2 border-0 border-b border-black">
      <ul>
        {resume.qualifications.map((line) => <li>{line.item}</li>)}
      </ul>
    </div>
  </article>

  <article class="mb-1 border-0 border-b border-black">
    <div class="flex pb-1 mb-3 border-0 border-b border-gray-200">
      <div class="flex flex-col">
        <h2>Work Experience</h2>
      </div>
    </div>

    {resume.experience.map((job) => (
      <>
        <div class="flex justify-between">
          <h3>{job.title} | {job.company} <span class="font-light">| {job.location}</span></h3>
          <span> {job.dateFrom} &mdash; {job.dateTo} </span>
        </div>
        <div class="flex mb-3">
          <ul>
            {job.work.map((line) => <li>{line.item}</li>)}
          </ul>
        </div>
      </>
    ))}
  </article>

  {resume.education && (
    <article>
      <div class="flex pb-1 mb-3 border-0 border-b border-gray-200">
        <div class="flex flex-col">
          <h2>Education</h2>
        </div>
      </div>

      {resume.education.map((school) => (
        <div class="flex justify-between mb-4">
          <h3>{school.degree} | {school.name} <span class="font-light">| {school.location}</span></h3>
          <span> {school.dateFrom} &mdash; {school.dateTo} </span>
        </div>
      ))}
    </article>
  )}
</div>
