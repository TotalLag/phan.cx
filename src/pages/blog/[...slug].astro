---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import MDXImage from '../../components/ui/MDXImage.astro';
import { createLogger } from '../../utils/logger';

const blogPostLogger = createLogger('BlogPostDetail');

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();

blogPostLogger.info(`Rendering blog post: ${post.slug}`);

// Define components to be used in MDX
const components = {
  img: MDXImage,
};
---

<BlogPost {...post.data}>
  <div class="mx-5" slot="hero">
    <MDXImage
      src={post.data.cover || ''}
      alt={post.data.caption || post.data.title}
      widths={[390, 768, 1024, 1600]}
      sizes="(min-width: 1536px) 1600px, (min-width: 1024px) 1024px, (min-width: 768px) 768px, 390px"
      format="webp"
      quality={80}
      class="w-full rounded-lg shadow-lg"
    />
    {post.data.caption && (
      <figcaption class="mt-2 text-xs italic text-muted">
        {post.data.caption}
      </figcaption>
    )}
  </div>
  <Content components={components} />
</BlogPost>
