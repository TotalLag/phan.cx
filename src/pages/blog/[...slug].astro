---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { Image } from 'astro:assets';
import MDXImage from '../../components/ui/MDXImage.astro';
import type { ImageMetadata } from 'astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();

// Get all blog images
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/blog/*', { eager: true });

// Placeholder image
const placeholderImage = {
  src: 'https://placehold.co/1600x900/222222/ffffff?text=Cover+Image+Not+Found',
  width: 1600,
  height: 900,
  format: 'webp'
} as ImageMetadata;

// Handle cover image
let coverImage: ImageMetadata;
try {
  if (post.data.cover?.startsWith('/blog/')) {
    const imageName = post.data.cover.replace('/blog/', '');
    const imagePath = `/src/assets/blog/${imageName}`;
    coverImage = images[imagePath]?.default || placeholderImage;
  } else if (post.data.cover?.startsWith('http')) {
    coverImage = {
      src: post.data.cover,
      width: 1600,
      height: 900,
      format: 'webp'
    } as ImageMetadata;
  } else {
    coverImage = placeholderImage;
  }
} catch (error) {
  coverImage = placeholderImage;
}

// Define components to be used in MDX
const components = {
  img: MDXImage,
};
---

<BlogPost {...post.data}>
  <div class="mx-5" slot="hero">
    <figure>
      <Image
        src={coverImage}
        alt={post.data.caption || post.data.title}
        widths={[390, 768, 1024, 1600]}
        sizes="(min-width: 1536px) 1600px, (min-width: 1024px) 1024px, (min-width: 768px) 768px, 390px"
        format="webp"
        quality={80}
        class="w-full rounded-lg shadow-lg"
      />
      {post.data.caption && (
        <figcaption class="mt-2 text-xs italic text-muted">
          {post.data.caption}
        </figcaption>
      )}
    </figure>
  </div>
  <Content components={components} />
</BlogPost>

<style>
  figure {
    margin: 0;
  }
</style>
