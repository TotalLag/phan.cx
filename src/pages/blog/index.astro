---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

interface BlogPost {
  slug: string;
  data: {
    title: string;
    excerpt: string;
    date: Date;
    cover?: string;
  };
}

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a: BlogPost, b: BlogPost) => 
  b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Blog">
  <main class="max-w-4xl px-4 py-8 mx-auto">
    <h1 class="mb-8 text-4xl font-bold text-primary">Blog Posts</h1>
    <div class="space-y-8">
      {sortedPosts.map((post: BlogPost) => (
        <article class="pb-8 border-b border-border">
          <a 
            href={`/blog/${post.slug}`} 
            class="block transition-opacity hover:opacity-75"
          >
            {post.data.cover && (
              <img 
                src={post.data.cover} 
                alt={post.data.title}
                class="object-cover w-full h-48 mb-4 rounded-lg shadow-sm"
              />
            )}
            <h2 class="mb-2 text-2xl font-bold transition-colors text-primary">
              {post.data.title}
            </h2>
            <p class="mb-2 transition-colors text-secondary">
              {post.data.excerpt}
            </p>
            <div class="text-sm transition-colors text-muted">
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </div>
          </a>
        </article>
      ))}
    </div>
  </main>
</Layout>

<style>
  /* Add smooth transitions for theme changes */
  article {
    transition: border-color 200ms ease-out;
  }

  h2, p, div {
    transition: color 200ms ease-out;
  }

  img {
    transition: opacity 200ms ease-out, box-shadow 200ms ease-out;
  }
</style>
