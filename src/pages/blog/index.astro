---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

interface BlogPost {
  slug: string;
  data: {
    title: string;
    excerpt: string;
    date: Date;
    cover?: string;
  };
}

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a: BlogPost, b: BlogPost) => 
  b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Blog">
  <main class="max-w-4xl px-4 py-8 mx-auto">
    <h1 class="mb-8 text-4xl font-bold">Blog Posts</h1>
    <div class="space-y-8">
      {sortedPosts.map((post: BlogPost) => (
        <article class="pb-8 border-b">
          <a href={`/blog/${post.slug}`} class="block hover:opacity-75">
            {post.data.cover && (
              <img 
                src={post.data.cover} 
                alt={post.data.title}
                class="object-cover w-full h-48 mb-4"
              />
            )}
            <h2 class="mb-2 text-2xl font-bold">{post.data.title}</h2>
            <p class="mb-2 text-gray-600">{post.data.excerpt}</p>
            <div class="text-sm text-gray-500">
              {post.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </div>
          </a>
        </article>
      ))}
    </div>
  </main>
</Layout>
