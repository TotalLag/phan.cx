---
import Layout from '../../layouts/Layout.astro';
import { getSkillColor } from '../../utils/skill-colors';
import type { ProjectData } from '../../types/projects';
import projectsJson from '../../content/projects/projects.json';

const { projects } = projectsJson as ProjectData;
const description = "Explore my portfolio of software development projects, featuring various technologies and solutions I've built.";
const keywords = [
  'software projects', 
  'portfolio', 
  'web development', 
  ...new Set(projects.flatMap(p => p.tech))
].join(', ');

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Chris Phan's Projects",
  "description": description,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": projects.map((project, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Project",
        "name": project.name,
        "description": `${project.what} - ${project.why}`,
        "url": project.link,
        "keywords": project.tech.join(", ")
      }
    }))
  }
};
---

<Layout 
  title="Projects"
  description={description}
  keywords={keywords}
  structuredData={structuredData}
>
  <div class="px-4 center-layout py-container-py md:px-0">
    <div class="w-full overflow-x-auto">
      {/* Desktop Table View */}
      <table class="hidden w-full rounded-lg shadow-sm md:table">
        <thead>
          <tr class="bg-surface-tertiary">
            <th class="px-[var(--gutter)] py-3 text-left text-sm font-medium text-text-secondary">Project</th>
            <th class="px-[var(--gutter)] py-3 text-left text-sm font-medium text-text-secondary">What</th>
            <th class="px-[var(--gutter)] py-3 text-left text-sm font-medium text-text-secondary">Why</th>
            <th class="px-[var(--gutter)] py-3 text-right text-sm font-medium text-text-secondary">Skills</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-surface-primary">
          {projects.map((project, i) => (
            <tr 
              class={i % 2 === 0 ? 'bg-surface-primary' : 'bg-surface-secondary'}
              itemscope 
              itemtype="https://schema.org/CreativeWork"
            >
              <td class="px-[var(--gutter)] py-4 whitespace-nowrap">
                <a 
                  href={project.link} 
                  class="text-accent hover:text-accent-hover"
                  itemprop="name"
                >
                  {project.name}
                </a>
              </td>
              <td class="px-[var(--gutter)] py-4">
                <p 
                  class="text-sm text-text-primary"
                  itemprop="description"
                >
                  {project.what}
                </p>
              </td>
              <td class="px-[var(--gutter)] py-4">
                <p 
                  class="text-sm text-text-primary"
                  itemprop="about"
                >
                  {project.why}
                </p>
              </td>
              <td class="px-[var(--gutter)] py-4">
                <div class="flex flex-wrap justify-end gap-1">
                  {project.tech.map((tech) => (
                    <span 
                      style={`background-color: ${getSkillColor(tech, 'var(--accent)')}`} 
                      class="inline-block h-fit w-auto px-2 py-0.5 text-xs rounded-full text-black"
                      itemprop="keywords"
                    >
                      {tech}
                    </span>
                  ))}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {/* Mobile Card View */}
      <div class="md:hidden">
        {projects.map((project, i) => (
          <div 
            class={`
              flex flex-col 
              p-4 
              ${i % 2 === 0 ? 'bg-surface-primary' : 'bg-surface-secondary'}
              border-b border-border last:border-b-0
            `}
            itemscope 
            itemtype="https://schema.org/CreativeWork"
          >
            <div class="grid grid-cols-2 gap-4 mb-3">
              <div>
                <a 
                  href={project.link} 
                  class="block mb-2 text-lg font-semibold text-accent hover:text-accent-hover"
                  itemprop="name"
                >
                  {project.name}
                </a>
              </div>
              <div class="flex flex-wrap justify-end gap-1">
                {project.tech.map((tech) => (
                  <span 
                    style={`background-color: ${getSkillColor(tech, 'var(--accent)')}`} 
                    class="inline-block h-fit w-auto px-2 py-0.5 text-xs rounded-full text-black"
                    itemprop="keywords"
                  >
                    {tech}
                  </span>
                ))}
              </div>
            </div>
            <div>
              <p 
                class="mb-2 text-sm text-text-primary"
                itemprop="description"
              >
                <span class="font-medium underline">What</span>: {project.what}
              </p>
              <p 
                class="text-sm text-text-primary"
                itemprop="about"
              >
                <span class="font-medium underline">Why</span>: {project.why}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{projects}}>
  // Client-side script to ensure color generation uses the actual accent color
  document.addEventListener('DOMContentLoaded', () => {
    const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
    const skillTags = document.querySelectorAll('.skill-tag');
    
    skillTags.forEach((tag) => {
      const tech = tag.textContent;
      const color = getSkillColor(tech, accentColor);
      tag.style.backgroundColor = color;
    });
  });
</script>
