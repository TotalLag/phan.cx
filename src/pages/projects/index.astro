---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { Project } from '../../types/projects';

const projectsEntries = await getCollection('projects');
const projectsData = projectsEntries[0];
if (!projectsData) throw new Error('Projects data not found');

const { projects } = projectsData.data;
---

<Layout title="Projects">
  <div class="px-container-px py-container-py">
    <div class="mx-auto">
      <div class="my-6 rounded-lg shadow-sm bg-surface-secondary">
        <table class="w-full">
          <thead>
            <tr class="text-center uppercase rounded-t-lg bg-surface-tertiary">
              <th class="px-4 py-3 font-medium">Project</th>
              <th class="px-4 py-3 font-medium">What</th>
              <th class="px-4 py-3 font-medium min-w-[24rem]">Why</th>
              <th class="px-4 py-3 font-medium">Skills</th>
            </tr>
          </thead>
          <tbody class="text-sm">
            {projects.map((project: Project) => (
              <tr class="border-t hover:bg-surface-hover border-divider">
                <td class="px-4 py-3 text-center">
                  <div class="flex items-center justify-center">
                    <a href={project.link} class="text-link hover:text-link-hover">
                      <span class="font-medium">{project.name}</span>
                    </a>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center">
                    <span>{project.what}</span>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center">
                    <span>{project.why}</span>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap items-start justify-end gap-1">
                    {project.tech.map((tech: string) => (
                      <span class="px-2 py-0.5 text-xs rounded-full bg-surface-tertiary text-text-secondary whitespace-nowrap">
                        {tech}
                      </span>
                    ))}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
