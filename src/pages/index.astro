---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Get all blog images
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/blog/*', { eager: true });

// Placeholder image
const placeholderImage = {
  src: 'https://placehold.co/800x600/222222/ffffff?text=Cover+Image+Not+Found',
  width: 800,
  height: 600,
  format: 'webp'
} as ImageMetadata;

// Helper function to get image data
function getCoverImage(cover: string | undefined): ImageMetadata {
  try {
    if (cover?.startsWith('/blog/')) {
      const imageName = cover.replace('/blog/', '');
      const imagePath = `/src/assets/blog/${imageName}`;
      return images[imagePath]?.default || placeholderImage;
    }
    if (cover?.startsWith('http')) {
      return {
        src: cover,
        width: 800,
        height: 600,
        format: 'webp'
      } as ImageMetadata;
    }
  } catch (error) {
    // Return placeholder for any errors
  }
  return placeholderImage;
}

interface InstagramPost {
  id: string;
  image: string;
}

const instagramPosts: InstagramPost[] = [
  { id: '1', image: 'https://placehold.co/400x400/2563eb/ffffff' },
  { id: '2', image: 'https://placehold.co/400x400/1e40af/ffffff' },
  { id: '3', image: 'https://placehold.co/400x400/1d4ed8/ffffff' },
];
---

<Layout title="Home">
  <div>
    <section class="mb-16" transition:animate="slide">
      <h1 class="mb-6 text-2xl font-bold leading-tight text-primary">
        A BEAUTIFUL, RESPONSIVE, STATICALLY-GENERATED, SVELTE APPLICATION WRITTEN WITH MODERN JAVASCRIPT.
      </h1>
      
      <div class="space-y-4 text-base leading-relaxed text-secondary">
        <p>
          Welcome to my website! Please feel free to read my musings, or you can check out my resume, projects, random stats, or contact me.
        </p>
        
        <p>
          This site serves as my portfolio and there will be many aspects that will be ongoing development. As the pieces come together, you can expect to see more of what makes us all parts for this website; but until then enjoy seeing how things are put together on GitHub!
        </p>
        
        <p>
          Source available <a href="#" class="transition-colors text-accent hover:text-accent-hover hover:underline">here</a>.
        </p>
      </div>
    </section>

    <section class="mb-16" transition:animate="fade">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-primary">Featured Posts</h2>
        <select class="h-10 px-4 text-sm transition-all border cursor-pointer bg-surface-secondary border-border text-primary rounded-input hover:border-border-hover focus:border-border-focus focus:outline-none focus:ring-2 focus:ring-accent/20 duration-base ease-soft">
          <option>All Time</option>
          <option>This Week</option>
          <option>This Month</option>
          <option>This Year</option>
        </select>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map(post => {
          const coverImage = getCoverImage(post.data.cover);
          return (
            <a href={`/blog/${post.slug}`} class="group">
              <div class="relative overflow-hidden rounded shadow-sm h-44">
                <div transition:name={`hero-${post.slug}`}>
                  <Image 
                    src={coverImage}
                    alt={post.data.title}
                    widths={[390, 480, 640, 800]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    format="webp"
                    quality={80}
                    class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
                <div class="absolute bottom-0 p-3">
                  <div 
                    class="mb-1 text-xs tracking-wide uppercase text-white/80"
                    transition:name={`topic-${post.slug}`}
                  >
                    {post.data.topic}
                  </div>
                  <h3 
                    class="text-sm font-medium leading-snug text-white"
                    transition:name={`title-${post.slug}`}
                  >
                    {post.data.title}
                  </h3>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section transition:animate="fade">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-primary">Instagram Photo Feed</h2>
        <select class="h-10 px-4 text-sm transition-all border cursor-pointer bg-surface-secondary border-border text-primary rounded-input hover:border-border-hover focus:border-border-focus focus:outline-none focus:ring-2 focus:ring-accent/20 duration-base ease-soft">
          <option>All Time</option>
          <option>This Week</option>
          <option>This Month</option>
          <option>This Year</option>
        </select>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {instagramPosts.map(post => (
          <div class="overflow-hidden rounded shadow-sm aspect-square">
            <Image 
              src={{
                src: post.image,
                width: 400,
                height: 400,
                format: 'webp'
              } as ImageMetadata}
              alt={`Instagram post ${post.id}`}
              width={400}
              height={400}
              class="object-cover w-full h-full"
            />
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
