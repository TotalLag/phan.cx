---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import MDXImage from '../components/ui/MDXImage.astro';
import type { CollectionEntry } from 'astro:content';
import { createLogger } from '../utils/logger';

const homeLogger = createLogger('HomePage');

// Get blog posts
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => 
  b.data.date.getTime() - a.data.date.getTime()
);

homeLogger.debug(`Fetched and sorted ${posts.length} blog posts`);

// Get Instagram posts
const instagramPosts: CollectionEntry<'instagram'>[] = await getCollection('instagram');
const sortedInstagramPosts = instagramPosts.sort(
  (a: CollectionEntry<'instagram'>, b: CollectionEntry<'instagram'>) => {
    return b.data.date.getTime() - a.data.date.getTime();
  }
);

homeLogger.debug(`Fetched and sorted ${instagramPosts.length} Instagram posts`);

const description = "Welcome to my personal website showcasing my portfolio, blog posts, and Instagram feed. Explore my latest projects, technical writings, and photography.";
homeLogger.info('Generated home page description');
---

<Layout 
  title="Home"
  description={description}
>
  <div>
    <section class="mb-16" transition:animate="slide">
      <h1 class="mb-6 text-2xl font-bold leading-tight text-primary">
        A BEAUTIFUL, RESPONSIVE, STATICALLY-GENERATED, ASTRO APPLICATION WRITTEN WITH MODERN JAVASCRIPT.
      </h1>
      
      <div class="space-y-4 text-base leading-relaxed text-secondary">
        <p>
          Welcome to my website! Please feel free to read my musings, or you can check out my resume, projects, random stats, or contact me.
        </p>
        
        <p>
          This site serves as my portfolio and there will be many aspects that will be ongoing development. As the pieces come together, you can expect to see more of what makes us all parts for this website; but until then enjoy seeing how things are put together on GitHub!
        </p>
        
        <p>
          Source available <a href="https://github.com/TotalLag/phan.cx" class="transition-colors text-accent hover:text-accent-hover hover:underline">here</a>.
        </p>
      </div>
    </section>

    <section class="mb-16 -mx-[var(--gutter)]" transition:animate="fade">
      <div class="flex items-center justify-between mb-6 px-[var(--gutter)]">
        <h2 class="text-xl font-bold text-primary">Featured Posts</h2>
        <select class="h-10 px-4 text-sm transition-all border cursor-pointer bg-surface-secondary border-border text-primary rounded-input hover:border-border-hover focus:border-border-focus focus:outline-none focus:ring-2 focus:ring-accent/20 duration-base ease-soft">
          <option>All Time</option>
          <option>This Week</option>
          <option>This Month</option>
          <option>This Year</option>
        </select>
      </div>

      <div class="flex overflow-x-auto pb-4 px-[var(--gutter)] gap-[var(--gutter)]">
        {sortedPosts.map((post: CollectionEntry<'blog'>) => (
          <a href={`/blog/${post.slug}`} class="flex-none w-40 group">
            <div class="relative h-64 overflow-hidden rounded shadow-sm">
              <div transition:name={`hero-${post.slug}`} class="w-full h-full">
                <MDXImage 
                  src={post.data.cover || ''}
                  alt={post.data.title}
                  widths={[390, 480, 640, 800]}
                  sizes="160px"
                  format="webp"
                  quality={80}
                  overlay
                  class="transition-transform duration-base ease-soft group-hover:scale-105"
                />
              </div>
              <div class="absolute bottom-0 z-10 p-3">
                <div 
                  class="mb-1 text-xs tracking-wide uppercase text-white/80"
                  transition:name={`topic-${post.slug}`}
                >
                  {post.data.topic}
                </div>
                <h3 
                  class="text-sm font-medium leading-snug text-white"
                  transition:name={`title-${post.slug}`}
                >
                  {post.data.title}
                </h3>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section transition:animate="fade">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-primary">Instagram Photo Feed</h2>
        <select class="h-10 px-4 text-sm transition-all border cursor-pointer bg-surface-secondary border-border text-primary rounded-input hover:border-border-hover focus:border-border-focus focus:outline-none focus:ring-2 focus:ring-accent/20 duration-base ease-soft">
          <option>All Time</option>
          <option>This Week</option>
          <option>This Month</option>
          <option>This Year</option>
        </select>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {sortedInstagramPosts.map((post: CollectionEntry<'instagram'>) => (
          <div class="overflow-hidden rounded shadow-sm aspect-square">
            <MDXImage 
              src={post.data.image}
              alt={post.data.caption || `Instagram post by ${post.data.username}`}
              width={400}
              height={400}
              class="object-cover w-full h-full transition-transform duration-base ease-soft hover:scale-105"
            />
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
