---
import Sidebar from './Sidebar.astro';
import CircleButton from './ui/CircleButton.astro';
---

<div class="lg:hidden">
  <!-- Hidden checkbox for toggle state -->
  <input type="checkbox" id="nav-toggle" class="hidden peer" aria-hidden="true">
  
  <!-- Menu button / Label for checkbox -->
  <CircleButton 
    label="Toggle menu" 
    as="label" 
    for="nav-toggle"
    class="fixed top-6 left-6 z-popover"
  >
    <svg 
      class="w-5 h-5 text-icon hover:text-icon-hover" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="2" 
        d="M4 6h16M4 12h16M4 18h16"
      />
    </svg>
  </CircleButton>

  <!-- Sidebar -->
  <div 
    class="fixed inset-y-0 left-0 transition-transform transform -translate-x-full w-sidebar bg-surface-primary duration-modal ease-soft z-modal peer-checked:translate-x-0 shadow-modal"
  >
    <div class="h-full overflow-y-auto">
      <Sidebar />
    </div>
  </div>

  <!-- Backdrop -->
  <label
    for="nav-toggle"
    class="fixed inset-0 invisible transition-all opacity-0 z-overlay bg-overlay-dark duration-modal ease-soft peer-checked:opacity-100 peer-checked:visible"
    aria-hidden="true"
  />
</div>

<style>
  /* Prevent scrolling when menu is open */
  #nav-toggle:checked ~ .fixed {
    overflow: hidden;
  }

  /* Hide menu button when printing */
  @media print {
    #nav-toggle,
    label[for="nav-toggle"] {
      display: none;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .transition-transform,
    .transition-all {
      transition: none;
    }
  }

  /* Ensure smooth scrolling in sidebar */
  .overflow-y-auto {
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.2) transparent;
  }

  .overflow-y-auto::-webkit-scrollbar {
    width: 6px;
  }

  .overflow-y-auto::-webkit-scrollbar-track {
    background: transparent;
  }

  .overflow-y-auto::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
  }
</style>
