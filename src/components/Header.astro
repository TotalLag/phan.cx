---
import CircleButton from './ui/CircleButton.astro';
import SearchInput from './ui/SearchInput.astro';
---

<header class="site-header">
  <div class="header-container">
    <div class="lg:hidden">
      <CircleButton 
        label="Toggle menu" 
        as="label" 
        for="nav-toggle"
      >
        <svg 
          class="w-5 h-5 text-icon hover:text-icon-hover" 
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </CircleButton>
    </div>
    <div class="flex items-center justify-between flex-1 ml-inline lg:ml-0">
      <SearchInput class="lg:py-4" />
      <CircleButton label="Notifications" class="ml-inline">
        <svg 
          class="w-5 h-5 text-icon hover:text-icon-hover" 
          fill="none" 
          stroke="currentColor" 
          viewBox="0 0 24 24"
        >
          <path 
            stroke-linecap="round" 
            stroke-linejoin="round" 
            stroke-width="2" 
            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          />
        </svg>
      </CircleButton>
    </div>
  </div>
</header>
