---
import CircleButton from './ui/CircleButton.astro';
import SearchInput from './ui/SearchInput.astro';
import ThemeToggle from './ui/ThemeToggle';
import Notifications from './ui/Notifications.astro';
---

<header class="site-header" transition:persist transition:persist-props>
  <div class="w-full h-full px-container-px">
    <nav class="h-full gap-4 flex-layout">
      <div class="lg:hidden">
        <CircleButton 
          label="Toggle menu" 
          as="label" 
          for="nav-toggle"
        >
          <svg 
            class="w-5 h-5 transition-colors duration-200 text-icon hover:text-icon-hover" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path 
              stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="2" 
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </CircleButton>
      </div>
      
      <div class="flex-1 h-full gap-4 flex-layout">
        <SearchInput class="flex-1" />
        
        <div class="flex-shrink-0 gap-2 flex-layout">
          <ThemeToggle client:load />
          <Notifications />
        </div>
      </div>
    </nav>
  </div>
</header>
