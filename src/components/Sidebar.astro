---
import '../styles/glitch.css';
import CoffeeCounter from './CoffeeCounter';
import MDXImage from '../components/ui/MDXImage.astro';
import profileImage from '../../public/me.jpg';
import codeStats from '../data/code-stats.json';
import { createLogger } from '../utils/logger';

const sidebarLogger = createLogger('Sidebar');

const stats = {
  cups: "69",
  lines: codeStats.formattedLines,
  cats: "2"
};

sidebarLogger.debug(`Initialized sidebar stats: ${JSON.stringify(stats)}`);

// Get current path for active link highlighting
const { pathname } = Astro.url;

// Check if we're on a blog post
const isBlogPost = pathname.startsWith('/blog/') && pathname !== '/blog/';

// Common navigation link class
const navLinkClass = "flex items-center py-2 text-sm px-container-px hover:bg-surface-hover text-icon border-l-[6px] border-transparent [&[aria-current]]:text-primary [&[aria-current]]:font-medium [&[aria-current]]:border-profile";
---

<aside class="flex flex-col h-full">
  <div class="flex-1">
    <div class="px-container-px py-section">
      <h1 class="glitch-text">
        <span class="glitch" data-text="> ⱧɆⱠⱠØ ₩ØⱤⱠĐ!">> HELLO</span>
      </h1>
    </div>

    <div class="flex flex-col items-center pt-8 pb-6">
      <div class="relative mb-3 w-profile h-profile">
        <div class="w-full h-full overflow-hidden border-4 border-profile rounded-profile shadow-card">
          <MDXImage 
            src={profileImage} 
            alt="Profile" 
            class="object-cover w-full h-full" 
            width={128}
            height={128}
          />
        </div>
      </div>
      <h2 class="text-base font-medium mb-0.5 text-primary">Chris Phan</h2>
      <p class="text-sm text-icon-muted">Texas, USA</p>
    </div>

    <div class="flex justify-around py-4 border-t border-b px-container-px border-border">
      <CoffeeCounter client:load initialCount={stats.cups} />
      <div class="text-center">
        <div class="text-base font-bold text-primary">{stats.lines}</div>
        <div class="text-xs leading-tight uppercase text-icon-muted">
          LINES OF<br/>CODE
        </div>
      </div>
      <div class="text-center">
        <div class="text-base font-bold text-primary">{stats.cats}</div>
        <div class="text-xs leading-tight uppercase text-icon-muted">
          CATS
        </div>
      </div>
    </div>

    <nav class="py-4">
      <a 
        href="/" 
        class={navLinkClass}
        aria-current={pathname === "/" ? "page" : undefined}
      >
        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        About
      </a>

      {isBlogPost && (
        <a 
          href="#" 
          class={navLinkClass}
          aria-current="page"
        >
          <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          </svg>
          Blog
        </a>
      )}

      <a 
        href="/resume" 
        class={navLinkClass}
        aria-current={pathname === "/resume" ? "page" : undefined}
      >
        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a1.5 1.5 0 00-1.5-1.5H15" />
        </svg>
        Resume
      </a>

      <a 
        href="/projects" 
        class={navLinkClass}
        aria-current={pathname === "/projects" ? "page" : undefined}
      >
        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Projects
      </a>

      <a 
        href="https://ko-fi.com/chrisphan" 
        class={navLinkClass}
        aria-current={pathname === "/contact" ? "page" : undefined}
      >
        <svg class="w-4 h-4 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Contact
      </a>
    </nav>
  </div>

  <div class="mb-16 p-container-px">
    <div class="flex justify-center space-x-inline">
      <a href="https://www.linkedin.com/in/christopherphan/" class="text-icon-muted hover:text-icon-hover">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
      <a href="https://github.com/TotalLag/" class="text-icon-muted hover:text-icon-hover">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    </div>
  </div>
</aside>
