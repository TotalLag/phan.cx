---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getImageData } from '../../utils/images';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  overlay?: boolean;
  [key: string]: any;
}

const { src, alt, overlay, class: className, ...props } = Astro.props;
const imageSource = await getImageData(src);
---

<div class="relative h-full overflow-hidden">
  <div class="image-shimmer"></div>
  {overlay && (
    <div class="absolute inset-0 z-20 bg-gradient-to-t from-[var(--overlay-dark)] to-transparent pointer-events-none"></div>
  )}
  <Image 
    src={imageSource}
    alt={alt}
    class={`relative z-10 h-full w-full object-cover transition-opacity duration-base ease-soft ${className || ''}`}
    onload="this.style.opacity = 1; this.parentNode.querySelector('.image-shimmer').classList.add('loaded')"
    style="opacity: 0"
    {...props}
  />
</div>
