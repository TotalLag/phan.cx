---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getImageData } from '../../utils/images';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  overlay?: boolean;
  [key: string]: any;
}

const { src, alt, overlay, class: className, ...props } = Astro.props;
const imageSource = await getImageData(src);
---

<div class="relative h-full overflow-hidden">
  <div class="image-shimmer"></div>
  {overlay && (
    <div class="absolute inset-0 z-20 bg-gradient-to-t from-[var(--overlay-dark)] to-transparent pointer-events-none"></div>
  )}
  <Image 
    src={imageSource}
    alt={alt}
    loading="lazy"
    decoding="async"
    class={`relative z-10 h-full w-full object-cover opacity-0 transition-opacity duration-base ease-soft ${className || ''}`}
    onload="try { this.classList.remove('opacity-0'); this.parentNode.querySelector('.image-shimmer').classList.add('loaded') } catch (e) {}"
    onerror="(e => { this.src = 'https://placehold.co/1200x800/222222/ffffff?text=Failed+to+load' })()"
    {...props}
  />
</div>
