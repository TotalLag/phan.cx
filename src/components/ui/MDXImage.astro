---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { src, alt } = Astro.props;

// Get all blog images
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/blog/*', { eager: true });

// Placeholder image
const placeholderImage = {
  src: 'https://placehold.co/1200x800/222222/ffffff?text=Image+Not+Found',
  width: 1200,
  height: 800,
  format: 'webp'
} as ImageMetadata;

// For local images, convert /blog/image.jpg to just image.jpg and get the image data
let imageData: ImageMetadata;
try {
  if (src.startsWith('/blog/')) {
    const imageName = src.replace('/blog/', '');
    const imagePath = `../../assets/blog/${imageName}`;
    imageData = images[imagePath]?.default || placeholderImage;
  } else if (src.startsWith('http')) {
    imageData = {
      src: src,
      width: 1200,
      height: 800,
      format: 'webp'
    } as ImageMetadata;
  } else {
    imageData = placeholderImage;
  }
} catch (error) {
  imageData = placeholderImage;
}
---

<figure>
  <Image 
    src={imageData}
    alt={alt}
    widths={[320, 640, 960, 1200]}
    sizes="(min-width: 1280px) 1200px, (min-width: 1024px) 960px, (min-width: 768px) 640px, 320px"
    format="webp"
    quality={80}
    class="w-full rounded-lg shadow-lg"
  />
</figure>
