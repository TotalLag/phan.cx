---
interface Props {
  placeholder?: string;
  class?: string;
}

const { placeholder = "Search", class: className } = Astro.props;
---

<div class={`relative flex-1 ${className}`}>
  <div class="relative">
    <svg 
      class="absolute w-4 h-4 -translate-y-1/2 pointer-events-none left-3 top-1/2 text-icon-muted" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="2" 
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
      />
    </svg>
    <input 
      type="search" 
      placeholder={placeholder}
      class="search-input"
      aria-label={placeholder}
    />
  </div>
</div>
