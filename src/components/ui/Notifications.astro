---
import NotificationsButton from './NotificationsButton';
import { type Release, getGitHubReleases } from '../../utils/github';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Get releases at build time
const releases = await getGitHubReleases();
---

<div class:list={["relative", className]}>
  <NotificationsButton client:load releases={releases} />
</div>
