---
import NotificationsButton from './NotificationsButton';
import { getGitHubReleases } from '../../utils/github';
import { createLogger } from '../../utils/logger';

const notificationsLogger = createLogger('Notifications');

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Get releases at build time
notificationsLogger.debug('Fetching GitHub releases');
const releases = await getGitHubReleases();
notificationsLogger.info(`Loaded ${releases.length} GitHub releases`);
---

<div class:list={["relative", className]}>
  <NotificationsButton client:load releases={releases} />
</div>
