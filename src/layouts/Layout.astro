---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { ViewTransitions } from 'astro:transitions';
import ThemeScript from '../components/ThemeScript';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Personal website and blog" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
    <ThemeScript client:load />
  </head>
  <body class="min-h-screen bg-surface-primary">
    <!-- Mobile Menu Container -->
    <div class="lg:hidden" transition:persist transition:persist-props>
      <input 
        type="checkbox" 
        id="nav-toggle" 
        class="hidden peer" 
        aria-hidden="true"
      >
      
      <!-- Mobile Sidebar -->
      <div class="site-sidebar-mobile">
        <div class="h-full pt-20 overflow-y-auto">
          <Sidebar />
        </div>
      </div>

      <!-- Backdrop -->
      <label
        for="nav-toggle"
        class:list={[
          'fixed inset-0 bg-overlay-dark z-overlay',
          'invisible opacity-0',
          'peer-checked:visible peer-checked:opacity-100',
          'transition-all duration-modal ease-soft'
        ]}
        aria-hidden="true"
      />
    </div>

    <!-- Desktop Sidebar -->
    <div 
      class="site-sidebar"
      transition:persist
      transition:persist-props
    >
      <Sidebar />
    </div>

    <!-- Main Content Area -->
    <div class="flex flex-col min-h-screen lg:pl-sidebar bg-surface-primary">
      <!-- Header -->
      <Header />

      <!-- Main Content -->
      <main class="main-content">
        <div class="w-full max-w-none">
          <slot />
        </div>
      </main>

      <!-- Footer -->
      <footer 
        class="site-footer"
        transition:persist
        transition:persist-props
      >
        <div class="h-full flex-layout px-container-px">
          <div class="text-sm text-icon-muted">
            Built with <span class="text-red-500" aria-hidden="true">❤️</span>
            <span class="sr-only">love</span> and Astro + SolidJS + Tailwind CSS
          </div>
        </div>
      </footer>
    </div>

    <!-- Initialize theme before view transitions -->
    <script>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        document.documentElement.classList.add(savedTheme);
      } else {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = prefersDark ? 'dark' : 'light';
        document.documentElement.classList.add(theme);
        localStorage.setItem('theme', theme);
      }
    </script>
  </body>
</html>
