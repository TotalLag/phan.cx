---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { ViewTransitions } from 'astro:transitions';
import releases from '../data/releases.json';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  structuredData?: any;
}

const { 
  title, 
  description = "Personal website featuring portfolio, blog, and search functionality", 
  keywords = "portfolio, blog, technology, software engineering, web development",
  image = "/me.jpg",
  structuredData = {}
} = Astro.props;

const siteUrl = 'https://phan.cx';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const formattedTitle = `${title} - phan.cx`;
const socialImage = new URL(image, siteUrl);

// Default Person Schema
const defaultPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Chris Phan",
  "jobTitle": "Integration Specialist",
  "url": "https://phan.cx",
  "sameAs": [
    "https://www.linkedin.com/in/christopherphan/",
    "https://github.com/TotalLag/"
  ]
};

// Merge default schema with custom structured data
const mergedStructuredData = {
  ...defaultPersonSchema,
  ...structuredData
};

// Get the latest version from releases
const latestVersion = releases[0]?.tag || 'v0.0.0';
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    
    <!-- Primary Meta Tags -->
    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    
    <!-- Authorship and Ownership -->
    <meta name="author" content="chris@phan.cx" />
    <meta name="copyright" content="© 2024 Chris Phan" />
    
    <!-- Robots and Crawling -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    
    <!-- Language and Localization -->
    <meta name="language" content="English" />
    <meta name="geo.region" content="US" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Chris Phan's Portfolio" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="phan.cx" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={formattedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />
    
    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Theme and Rendering -->
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(mergedStructuredData)}></script>
    
    <!-- Inline Theme Initialization Script -->
    <script is:inline>
      (() => {
        const THEME_KEY = 'theme';
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        
        const getTheme = () => {
          const saved = localStorage.getItem(THEME_KEY);
          return saved || (prefersDark.matches ? 'dark' : 'light');
        };

        const applyTheme = (theme) => {
          document.documentElement.classList.remove('light', 'dark');
          document.documentElement.classList.add(theme);
          document.documentElement.style.colorScheme = theme;
        };

        // Initial theme application
        applyTheme(getTheme());

        // Astro view transition handler
        document.addEventListener('astro:before-swap', (event) => {
          const theme = getTheme();
          event.newDocument.documentElement.classList.remove('light', 'dark');
          event.newDocument.documentElement.classList.add(theme);
          event.newDocument.documentElement.style.colorScheme = theme;
        });
      })();
    </script>
    
    <ViewTransitions fallback="swap" />
  </head>
  <body class="min-h-screen bg-surface-primary">
    <!-- Desktop Sidebar -->
    <div class="hidden site-sidebar lg:block" transition:name="desktop-sidebar">
      <Sidebar />
    </div>

    <!-- Main Content Area -->
    <div class="flex flex-col min-h-screen lg:pl-sidebar">
      <!-- Header -->
      <Header />

      <!-- Main Content -->
      <main class="flex-1 main-content">
        <div class="w-full max-w-none">
          <slot />
        </div>
      </main>

      <!-- Footer -->
      <footer 
        class="site-footer"
        transition:name="footer"
      >
        <div class="flex items-center justify-between h-full flex-layout px-container-px">
          <div class="flex items-center text-xs md:text-sm text-icon-muted">
            Built with <span class="text-red-500" aria-hidden="true"> ❤️ </span>
            <span class="sr-only">love</span> and Astro + SolidJS + Tailwind CSS
          </div>
          <div class="text-[0.6rem] opacity-50">
            {latestVersion}
          </div>
        </div>
      </footer>
    </div>

    <!-- Mobile Menu Portal -->
    <div class="fixed inset-0 pointer-events-none lg:hidden isolate" transition:name="mobile-menu">
      <input 
        type="checkbox" 
        id="nav-toggle" 
        class="hidden peer" 
        aria-hidden="true"
      >

      <!-- Backdrop -->
      <label 
        for="nav-toggle"
        class:list={[
          'fixed inset-0 bg-overlay-dark z-overlay pointer-events-auto', 
          'hidden opacity-0',
          'peer-checked:block peer-checked:opacity-100',
          'transition-all duration-modal ease-soft'
        ]}
        aria-hidden="true"
      />

      <!-- Mobile Sidebar -->
      <aside class:list={[
        'fixed inset-y-0 left-0 w-sidebar bg-surface-primary shadow-modal z-modal pointer-events-auto',
        'transform -translate-x-full',
        'peer-checked:translate-x-0',
        'transition-transform duration-modal ease-soft'
      ]}>
        <div class="h-full pt-20 overflow-y-auto">
          <Sidebar />
        </div>
      </aside>
    </div>
  </body>
</html>
