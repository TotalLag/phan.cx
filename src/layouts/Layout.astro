---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { ViewTransitions } from 'astro:transitions';
import ThemeScript from '../components/ThemeScript';
import CriticalCSS from './CriticalCSS.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  structuredData?: any;
}

const { 
  title, 
  description = "Personal website featuring portfolio, blog, and search functionality", 
  keywords = "portfolio, blog, technology, software engineering, web development",
  image = "/me.jpg",
  structuredData = {}
} = Astro.props;

const siteUrl = 'https://phan.cx';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const formattedTitle = `${title} - phan.cx`;
const socialImage = new URL(image, siteUrl);

// Default Person Schema
const defaultPersonSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Chris Phan",
  "jobTitle": "Integration Specialist",
  "url": "https://phan.cx",
  "sameAs": [
    "https://www.linkedin.com/in/christopherphan/",
    "https://github.com/TotalLag/"
  ]
};

// Merge default schema with custom structured data
const mergedStructuredData = {
  ...defaultPersonSchema,
  ...structuredData
};
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    
    <CriticalCSS />
    
    <!-- Primary Meta Tags -->
    <title>{formattedTitle}</title>
    <meta name="title" content={formattedTitle} />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    
    <!-- Authorship and Ownership -->
    <meta name="author" content="chris@phan.cx" />
    <meta name="copyright" content="© 2024 Chris Phan" />
    
    <!-- Robots and Crawling -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    
    <!-- Language and Localization -->
    <meta name="language" content="English" />
    <meta name="geo.region" content="US" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Chris Phan's Portfolio" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="phan.cx" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={formattedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />
    
    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Theme and Rendering -->
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(mergedStructuredData)}></script>
    
    <ViewTransitions />
    <ThemeScript client:load />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-surface-primary">
    <!-- Mobile Menu Container -->
    <div class="lg:hidden" transition:persist transition:persist-props>
      <input 
        type="checkbox" 
        id="nav-toggle" 
        class="hidden peer" 
        aria-hidden="true"
      >
      
      <!-- Mobile Sidebar -->
      <div class="site-sidebar-mobile">
        <div class="h-full pt-20 overflow-y-auto">
          <Sidebar />
        </div>
      </div>

      <!-- Backdrop -->
      <label
        for="nav-toggle"
        class:list={[
          'fixed inset-0 bg-overlay-dark z-overlay',
          'invisible opacity-0',
          'peer-checked:visible peer-checked:opacity-100',
          'transition-all duration-modal ease-soft'
        ]}
        aria-hidden="true"
      />
    </div>

    <!-- Desktop Sidebar -->
    <div 
      class="site-sidebar"
      transition:persist
      transition:persist-props
    >
      <Sidebar />
    </div>

    <!-- Main Content Area -->
    <div class="flex flex-col min-h-screen lg:pl-sidebar bg-surface-primary">
      <!-- Header -->
      <Header />

      <!-- Main Content -->
      <main class="main-content">
        <div class="w-full max-w-none">
          <slot />
        </div>
      </main>

      <!-- Footer -->
      <footer 
        class="site-footer"
        transition:persist
        transition:persist-props
      >
        <div class="h-full flex-layout px-container-px">
          <div class="text-sm text-icon-muted">
            Built with <span class="text-red-500" aria-hidden="true">❤️</span>
            <span class="sr-only">love</span> and Astro + SolidJS + Tailwind CSS
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
