---
import Layout from './Layout.astro';

interface Props {
  title: string;
  topic?: string;
  excerpt: string;
  date: Date;
  updated?: Date;
  cover?: string;
  top?: boolean;
  caption?: string;
}

const { title, topic, excerpt, date, updated, cover, top, caption } = Astro.props;
---

<Layout title={title}>
  <article class="flex flex-col w-full mx-auto mt-6 md:w-4/5 markdown print:p-10">
    <div class="mx-5 my-3 text-sm">
      {topic && <a href="" class="font-bold tracking-widest transition-colors text-accent hover:text-accent-hover">{topic}</a>}
    </div>
    
    <div class="px-5 text-4xl font-bold leading-tight text-primary">
      <h1>{title}</h1>
    </div>

    <div class="px-5 pt-4 pb-6 text-lg text-secondary">
      {excerpt}
    </div>

    {cover && (
      <div class="mx-5">
        <img
          class:list={[
            "object-cover w-full max-h-96 rounded-lg shadow-lg",
            { "object-top": top }
          ]}
          src={cover}
          alt={caption}
        />
      </div>
    )}

    {caption && (
      <div class="mx-5 text-muted">
        <p class="py-3 text-sm italic border-b border-border">{caption}</p>
      </div>
    )}

    <div class="px-5 pt-4 italic font-light text-muted">
      <span class="flex flex-col text-sm">
        Posted on {date.toLocaleString('default', { dateStyle: 'long' })}<br />
        {updated && (
          <>
            Updated: {updated.toLocaleString('default', {
              dateStyle: 'long',
              timeStyle: 'short',
            })}
          </>
        )}
      </span>
    </div>

    <div class="px-5 py-8 mx-auto prose prose-lg max-w-none">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  /* Markdown Styles */
  .markdown {
    @apply leading-relaxed;
    color: var(--text-secondary);
  }

  .markdown h2 {
    @apply text-2xl font-bold mt-12 mb-6;
    color: var(--text-primary);
  }

  .markdown h3 {
    @apply text-xl font-semibold mt-8 mb-4;
    color: var(--text-primary);
  }

  .markdown p {
    @apply mb-6 text-lg leading-relaxed;
  }

  .markdown ul,
  .markdown ol {
    @apply mb-6 ml-8 text-lg;
  }

  .markdown li > p,
  .markdown li > ul,
  .markdown li > ol {
    @apply mb-2;
  }

  .markdown ol {
    @apply list-decimal;
  }

  .markdown ul {
    @apply list-disc;
  }

  .markdown blockquote {
    @apply p-4 mx-6 border-l-4 italic my-6;
    background-color: var(--surface-secondary);
    border-color: var(--border);
    color: var(--text-muted);
  }

  .markdown blockquote > p {
    @apply mb-0;
  }

  .markdown pre {
    @apply p-4 rounded-lg overflow-x-auto my-6;
    background-color: var(--surface-tertiary);
  }

  .markdown code {
    @apply px-1 py-0.5 rounded text-sm;
    background-color: var(--surface-tertiary);
    color: var(--text-primary);
  }

  .markdown a {
    @apply underline transition-colors;
    color: var(--accent);
  }

  .markdown a:hover {
    color: var(--accent-hover);
  }

  /* Dark mode adjustments */
  :root.dark .markdown pre,
  :root.dark .markdown code {
    background-color: var(--surface-tertiary);
  }

  :root.dark .markdown blockquote {
    background-color: var(--surface-tertiary);
  }
</style>
