---
import type { CollectionEntry } from "astro:content";
import Layout from './Layout.astro';

type Props = CollectionEntry<"blog">["data"];

const { title, topic, excerpt, date, updated } = Astro.props;
const slug = Astro.url.pathname.split('/').pop();
---

<Layout title={title}>
  <article class="flex flex-col w-full max-w-4xl mx-auto mt-6 print:p-10">
    <div class="mx-3 my-3 text-sm sm:mx-5" transition:animate="slide">
      {topic && <a href="" class="font-bold tracking-widest transition-colors text-accent hover:text-accent-hover" transition:name={`topic-${slug}`}>{topic}</a>}
    </div>
    
    <div class="px-3 text-4xl font-bold leading-tight sm:px-5 text-primary" transition:animate="slide">
      <h1 transition:name={`title-${slug}`}>{title}</h1>
    </div>

    <div class="px-3 pt-4 pb-6 text-lg sm:px-5 text-secondary" transition:animate="slide">
      <p transition:name={`excerpt-${slug}`}>{excerpt}</p>
    </div>

    <div transition:name={`hero-${slug}`}>
      <slot name="hero" />
    </div>

    <div class="px-3 pt-4 italic font-light sm:px-5 text-muted" transition:animate="slide">
      <span class="flex flex-col text-sm">
        <time transition:name={`date-${slug}`}>
          Posted on {date.toLocaleString('default', { dateStyle: 'long' })}
        </time>
        {updated && (
          <>
            Updated: {updated.toLocaleString('default', {
              dateStyle: 'long',
              timeStyle: 'short',
            })}
          </>
        )}
      </span>
    </div>

    <div class="w-full px-3 py-8 mx-auto overflow-hidden sm:px-5 prose-custom" transition:animate="fade">
      <slot />
    </div>
  </article>
</Layout>
