---
import Layout from './Layout.astro';

interface Props {
  title: string;
  topic?: string;
  excerpt: string;
  date: Date;
  updated?: Date;
  cover?: string;
  top?: boolean;
  caption?: string;
}

const { title, topic, excerpt, date, updated, cover, top, caption } = Astro.props;
---

<Layout title={title}>
  <article class="flex flex-col w-full mx-auto mt-6 md:w-4/5 print:p-10">
    <div class="mx-5 my-3 text-sm">
      {topic && <a href="" class="font-bold tracking-widest transition-colors text-accent hover:text-accent-hover">{topic}</a>}
    </div>
    
    <div class="px-5 text-4xl font-bold leading-tight text-primary">
      <h1>{title}</h1>
    </div>

    <div class="px-5 pt-4 pb-6 text-lg text-secondary">
      {excerpt}
    </div>

    {cover && (
      <div class="mx-5">
        <img
          class:list={[
            "object-cover w-full max-h-96 rounded-lg shadow-lg",
            { "object-top": top }
          ]}
          src={cover}
          alt={caption}
        />
        {caption && (
          <p class="mt-2 text-xs italic text-muted">{caption}</p>
        )}
      </div>
    )}

    <div class="px-5 pt-4 italic font-light text-muted">
      <span class="flex flex-col text-sm">
        Posted on {date.toLocaleString('default', { dateStyle: 'long' })}<br />
        {updated && (
          <>
            Updated: {updated.toLocaleString('default', {
              dateStyle: 'long',
              timeStyle: 'short',
            })}
          </>
        )}
      </span>
    </div>

    <div class="px-5 py-8 mx-auto prose prose-lg dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>
</Layout>

<style>
  /* Additional custom styles if needed */
  :global(.prose) {
    max-width: none;
  }

  :global(.prose a) {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  :global(.prose pre) {
    background-color: var(--surface-tertiary);
    border-radius: 0.5rem;
  }

  :global(.prose code) {
    background-color: var(--surface-tertiary);
    border-radius: 0.25rem;
    padding: 0.125rem 0.25rem;
    font-size: 0.875em;
  }

  :global(.prose img) {
    border-radius: 0.5rem;
    margin: 1.5rem auto;
  }

  :global(.prose blockquote) {
    font-style: italic;
    border-left-color: var(--border);
    background-color: var(--surface-secondary);
  }
</style>
