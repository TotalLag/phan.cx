---
// Critical CSS for Above-the-Fold Rendering
---
<style is:inline>
  /* Design Tokens and Global Resets */
  :root {
    color-scheme: light dark;
    --surface-primary: #ffffff;
    --surface-secondary: #f9fafb;
    --text-primary: #111827;
    --border: #e5e7eb;
    --gutter: clamp(1rem, 3vw, 1.5rem);
  }

  :root.dark {
    --surface-primary: #18181b;
    --surface-secondary: #27272a;
    --text-primary: #f9fafb;
    --border: #3f3f46;
  }

  /* Critical Layout Styles */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-height: 100vh;
    background-color: var(--surface-primary);
    color: var(--text-primary);
    line-height: 1.6;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  }

  /* Responsive Layout */
  .site-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    width: 100%;
    padding: var(--gutter);
  }

  /* Mobile Navigation */
  .site-sidebar-mobile {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--surface-primary);
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
  }

  .nav-toggle:checked + .site-sidebar-mobile {
    transform: translateX(0);
  }

  /* Desktop Sidebar Handling */
  @media (min-width: 1024px) {
    .site-layout {
      padding-left: 16rem; /* Tailwind's w-64 equivalent */
    }

    .site-sidebar-mobile {
      display: none;
    }
  }

  /* Footer */
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: var(--gutter);
  }

  /* Theme Transition */
  @media (prefers-reduced-motion: no-preference) {
    :root {
      transition: background-color 0.3s ease, color 0.3s ease;
    }
  }
</style>
