---
import type { ResumeData } from '../types/resume';
import '../styles/resume.css';

interface Props {
  resume: ResumeData;
  type: 'strategic' | 'technical';
}

const { resume, type } = Astro.props;
const { info, summary, qualifications, experience, education } = resume;

const formatSummary = (summary: string[]) => {
  return summary.join(' ◆ ');
};

const obfuscateEmail = (email: string) => {
  return email.replace('@', ' [at] ').replace(/\./g, ' [dot] ');
};
---

<div class="resume-nav">
  <div class="resume-nav-tabs">
    <a 
      href="/resume" 
      class:list={[
        "resume-nav-tab",
        type !== 'technical' ? 'resume-nav-tab-active' : 'resume-nav-tab-inactive'
      ]}
    >
      Strategic
    </a>
    <a 
      href="/resume/technical" 
      class:list={[
        "resume-nav-tab",
        type === 'technical' ? 'resume-nav-tab-active' : 'resume-nav-tab-inactive'
      ]}
    >
      Tactical
    </a>
  </div>
</div>

<div class="resume-container">
  <div class="resume-header">
    <h1 class="resume-name">{info.name}</h1>
    <div class="resume-contact">
      {info.address} | <span class="select-all">{obfuscateEmail(info.email)}</span>
    </div>
    <div class="resume-summary">
      {formatSummary(summary)}
    </div>
  </div>

  <section class="resume-section">
    <h2 class="resume-section-title">Summary of Qualifications</h2>
    <ul class="resume-list">
      {qualifications.map(qual => <li>{qual.item}</li>)}
    </ul>
  </section>

  <section class="resume-section">
    <h2 class="resume-section-title">Work Experience</h2>
    {experience.map(job => (
      <div class="resume-item">
        <div class="resume-item-header">
          <h3 class="resume-item-title">{job.title} | {job.company} | <span class="font-light">{job.location}</span></h3>
          <span class="resume-item-date">{job.dateFrom} &mdash; {job.dateTo}</span>
        </div>
        <ul class="resume-list">
          {job.work.map(item => <li>{item.item}</li>)}
        </ul>
      </div>
    ))}
  </section>

  {education && (
    <section class="resume-section">
      <h2 class="resume-section-title">Education</h2>
      {education.map((school) => (
        <div class="resume-item">
          <div class="resume-item-header">
            <h3 class="resume-item-title">{school.degree} | {school.name} <span class="font-light">| {school.location}</span></h3>
            <span class="resume-item-date">{school.dateFrom} &mdash; {school.dateTo}</span>
          </div>
        </div>
      ))}
    </section>
  )}
</div>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global(.site-sidebar),
    :global(.site-sidebar-mobile) {
      display: none !important;
    }

    :global(body) {
      margin: 0 !important;
      padding: 0 !important;
      background: white !important;
    }

    :global(main) {
      padding: 0 !important;
      margin: 0 !important;
      width: 100% !important;
      max-width: none !important;
    }
  }
</style>
